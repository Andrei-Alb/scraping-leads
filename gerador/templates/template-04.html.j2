{% import "_dados.html.j2" as d with context %}{% import "efeitos/_blocos.html.j2" as ef with context %}
{#- Ícones próprios da Noite: traço 1.25, pontas redondas, grade 24, cantos suaves. -#}
{%- set sv = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' -%}
{%- set ic_tel = (sv ~ '<path d="M7.5 3.5h-2a2 2 0 0 0-2 2.2C4.3 13.6 10.4 19.7 18.3 20.5a2 2 0 0 0 2.2-2v-2l-3.6-1.4-2 1.8a12 12 0 0 1-5.8-5.8l1.8-2z"/></svg>') | safe -%}
{%- set ic_wa = (sv ~ '<path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z"/><path d="M9.2 8.6c0 3.4 2.8 6.2 6.2 6.2l.9-1.6-1.8-.9-.8.8a4.4 4.4 0 0 1-2-2l.8-.8-.9-1.8z"/></svg>') | safe -%}
{%- set ic_pin = (sv ~ '<path d="M12 21.5s6.5-6.6 6.5-11.7a6.5 6.5 0 0 0-13 0c0 5.1 6.5 11.7 6.5 11.7z"/><path d="M12 7.3l2.2 2.4L12 12.1 9.8 9.7z"/></svg>') | safe -%}
{%- set ic_waze = (sv ~ '<path d="M6 17.5A7.5 7.5 0 1 1 19.2 13c-.6 1.6-1.8 2.9-3.2 3.6"/><circle cx="8.5" cy="19" r="1.5"/><circle cx="15" cy="18.5" r="1.5"/><path d="M10 12.5c1 .9 3 .9 4 0M10 9h.01M14 9h.01"/></svg>') | safe -%}
{%- set ic_maca = (sv ~ '<path d="M12 7.5C10.5 6.5 6.5 6 5.5 9.5s.5 7.5 2.5 10c1.2 1.4 2.4 1 4 .4 1.6.6 2.8 1 4-.4 1.2-1.4 2-3 2.4-4.4-2-1-2.6-4.6-.3-6C17 7 14 6.5 12 7.5z"/><path d="M12 7.5c0-2 1-3.5 3-4"/></svg>') | safe -%}
{%- set ic_contato = (sv ~ '<rect x="4" y="3.5" width="16" height="17" rx="1.5"/><circle cx="12" cy="10" r="2.6"/><path d="M8 16.5c.8-1.8 2.2-2.6 4-2.6s3.2.8 4 2.6"/></svg>') | safe -%}
{%- set ic_copiar = (sv ~ '<rect x="8.5" y="8.5" width="11" height="11" rx="1.5"/><path d="M15.5 5.5v-.5a1.5 1.5 0 0 0-1.5-1.5H5A1.5 1.5 0 0 0 3.5 5v9A1.5 1.5 0 0 0 5 15.5h.5"/></svg>') | safe -%}
{%- set ic_estrela = (sv ~ '<path d="M12 3.5l2.5 5.3 5.8.7-4.3 4 1.1 5.8L12 16.4l-5.1 2.9 1.1-5.8-4.3-4 5.8-.7z"/></svg>') | safe -%}
{%- set ic_contato_cta = ic_wa if wa else ic_tel -%}
<!doctype html>
<html lang="pt-BR">
<head>
{{ d.head("#0d0a07") }}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add("js")</script>
<style>
:root{
  --fundo:#0d0a07;--fundo-2:#15100b;--painel:#18120c;
  --texto:#efe6d6;--texto-2:#bfb39d;--ouro:#cfae6d;--champanhe:#ead7ab;
  --fio:rgba(207,174,109,.42);--fio-fraco:rgba(207,174,109,.18);
  --serifa:"Cormorant Garamond",Georgia,serif;--sans:"Jost",system-ui,sans-serif;
  --mx:min(1120px,100% - 2.5rem);--barra:0px;
  --sai:cubic-bezier(.16,1,.3,1);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scrollbar-color:var(--fio) var(--fundo)}
body{margin:0;background:var(--fundo);color:var(--texto);font:300 1.0625rem/1.75 var(--sans);letter-spacing:.01em;overflow-x:clip;padding-bottom:var(--barra)}
::selection{background:var(--ouro);color:var(--fundo)}
a{color:inherit;text-underline-offset:.25em;text-decoration-color:var(--fio)}
:focus-visible{outline:1px solid var(--champanhe);outline-offset:4px}
h1,h2,h3{font-family:var(--serifa);font-weight:300;line-height:1.08;margin:0;text-wrap:balance;overflow-wrap:normal;word-break:normal;hyphens:none}
h2{font-size:clamp(2rem,1.2rem + 3.6vw,3.4rem);letter-spacing:-.01em}
h3{font-size:1.6rem;font-weight:400}
p{margin:0}
.num{font-family:var(--sans);font-variant-numeric:tabular-nums lining-nums}
.mx{width:var(--mx);margin-inline:auto}

/* brilho dourado que acompanha a rolagem */
.brilho{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:clip}
.brilho::before{content:"";position:absolute;left:50%;top:calc(var(--g,0) * 100% - 30vmax);width:80vmax;height:60vmax;translate:-50% 0;
  background:radial-gradient(closest-side,rgba(207,174,109,.13),rgba(207,174,109,.04) 55%,transparent);filter:blur(10px)}
main,footer{position:relative;z-index:1}

/* topo */
.topo{position:absolute;inset:0 0 auto;z-index:2;display:flex;justify-content:center;padding:1.4rem 1.25rem}
.marca{font:400 .8rem/1 var(--sans);letter-spacing:.32em;text-transform:uppercase;color:var(--texto-2);text-align:center}

/* hero */
.hero{min-height:100svh;display:grid;place-items:center;text-align:center;padding:6.5rem 0 4.5rem;position:relative}
.hero .mx{max-width:56rem;display:grid;justify-items:center;gap:1.75rem}
.hero h1{font-size:clamp(2.4rem,1rem + 6.4vw,5.6rem);font-weight:300;letter-spacing:-.015em;line-height:1.02}
.hero h1 em{font-style:italic;color:var(--champanhe)}
.hero .sub{max-width:36rem;color:var(--texto-2);font-size:1.0625rem}
.filete{width:1px;height:64px;background:linear-gradient(var(--ouro),transparent)}
.acoes{display:flex;flex-wrap:wrap;justify-content:center;gap:.9rem;margin-top:.5rem}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;min-height:52px;padding:.8rem 1.6rem;border:1px solid var(--ouro);color:var(--champanhe);
  font:400 .8rem/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;text-decoration:none;background:transparent;cursor:pointer;
  transition:background-color .5s var(--sai),color .5s var(--sai)}
.btn:hover{background:var(--ouro);color:var(--fundo)}
.btn.cheio{background:var(--ouro);color:var(--fundo)}
.btn.cheio:hover{background:var(--champanhe)}
/* selo da nota: anel fino com o número no centro */
.selo{display:grid;justify-items:center;gap:.4rem;margin-top:1rem;text-decoration:none;color:var(--texto-2);font-size:1rem}
.selo .anel{position:relative;width:96px;height:96px;display:grid;place-items:center;border:1px solid var(--fio);border-radius:50%}
.selo .anel::before{content:"";position:absolute;inset:5px;border:1px solid var(--fio-fraco);border-radius:50%}
.selo .anel b{font:300 1.9rem/1 var(--sans);font-variant-numeric:tabular-nums lining-nums;color:var(--champanhe)}
.selo .anel svg{position:absolute;top:-10px;background:var(--fundo);padding:0 4px;width:24px;color:var(--ouro)}
.selo .rot{letter-spacing:.18em;text-transform:uppercase;font-size:.8rem}

/* revelação lenta do hero */
.rv{animation:revela 1.8s var(--sai) both;animation-delay:calc(var(--i,0) * .18s + .1s)}
.hero h1.rv{animation:revela-titulo 2.4s var(--sai) both .15s}
@keyframes revela{from{opacity:0;filter:blur(10px);translate:0 .6rem}}
@keyframes revela-titulo{from{opacity:0;filter:blur(18px);clip-path:inset(0 50% 0 50%);letter-spacing:.08em}to{clip-path:inset(0 0 0 0)}}

/* seções */
section{padding:clamp(5rem,4rem + 6vw,9rem) 0}
.cab{display:grid;gap:1.1rem;justify-items:center;text-align:center;margin-bottom:clamp(2.5rem,2rem + 3vw,4.5rem)}
.cab p{max-width:34rem;color:var(--texto-2)}
.cab::after{content:"";width:48px;height:1px;background:var(--ouro);order:-1;transform-origin:center}

/* painéis: borda dourada 1px e cantos finos */
.painel{position:relative;border:1px solid var(--fio-fraco);background:linear-gradient(180deg,rgba(24,18,12,.85),rgba(13,10,7,.6));padding:2rem 1.6rem}
.painel::before,.painel::after{content:"";position:absolute;width:14px;height:14px;border:1px solid var(--ouro);pointer-events:none}
.painel::before{top:-1px;left:-1px;border-right:0;border-bottom:0}
.painel::after{bottom:-1px;right:-1px;border-left:0;border-top:0}

/* fio que se desenha ao entrar na tela */
.risca{position:relative}
.risca::after{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,var(--ouro),transparent);transform:scaleX(0);transition:transform 1.6s var(--sai)}
.surge{transition:opacity 1.4s var(--sai),filter 1.4s var(--sai);transition-delay:calc(var(--i,0) * .12s)}
.js .surge:not(.visto){opacity:.0;filter:blur(8px)}
.visto.risca::after,.visto .risca::after{transform:scaleX(1)}

/* serviços */
.servicos{list-style:none;margin:0;padding:0;display:grid;gap:1.25rem}
.servicos h3{margin-bottom:.8rem}
.servicos p{color:var(--texto-2)}

/* diferenciais: lista com fios */
.dif{list-style:none;margin:0;padding:0;display:grid;max-width:60rem;margin-inline:auto}
.dif li{display:grid;gap:.6rem;padding:2rem 0;border-top:1px solid var(--fio-fraco)}
.dif li:last-child{border-bottom:1px solid var(--fio-fraco)}
.dif h3{color:var(--champanhe)}
.dif p{color:var(--texto-2);max-width:40rem}

/* passos */
.passos{list-style:none;margin:0;padding:0;display:grid;gap:1.25rem}
.passos li{text-align:center;display:grid;gap:.8rem;justify-items:center}
.passos .n{font:300 1.1rem/1 var(--sans);font-variant-numeric:tabular-nums;color:var(--ouro);width:52px;height:52px;display:grid;place-items:center;border:1px solid var(--fio);border-radius:50%}
.passos p{color:var(--texto-2)}

/* contato */
.contato{display:grid;gap:1.25rem}
.contato h3{margin-bottom:1rem}
.endereco{font-family:var(--serifa);font-size:1.45rem;line-height:1.35;font-weight:300;margin-bottom:1.25rem}
.lista-acoes{display:grid;gap:.6rem}
.lista-acoes .btn{justify-content:flex-start;width:100%}
.horario{margin:0;display:grid}
.horario div{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 0;border-bottom:1px solid var(--fio-fraco)}
.horario dt{color:var(--texto-2)}
.horario dd{margin:0;font-variant-numeric:tabular-nums;text-align:right}
.horario [data-hoje] dt,.horario [data-hoje] dd{color:var(--champanhe);font-weight:400}
.agora{display:inline-flex;align-items:center;gap:.6rem;margin-bottom:1rem;color:var(--texto)}
.agora::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--texto-2)}
.agora[data-aberto="1"]::before{background:#9fd39a;box-shadow:0 0 0 4px rgba(159,211,154,.15)}

/* mapa: obra emoldurada com passe-partout e legenda */
.chegar{display:grid;gap:2rem}
.moldura{margin:0;border:1px solid var(--fio);padding:10px;background:var(--fundo-2);position:relative}
.moldura::before,.moldura::after{content:"";position:absolute;width:22px;height:22px;border:1px solid var(--ouro);pointer-events:none}
.moldura::before{top:-6px;left:-6px;border-right:0;border-bottom:0}
.moldura::after{bottom:-6px;right:-6px;border-left:0;border-top:0}
.mapa{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--painel);outline:1px solid var(--fio-fraco)}
.mapa iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:grayscale(1) invert(.9) sepia(.35) contrast(.9)}
.moldura figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.25rem 1rem;padding:.9rem .4rem .2rem}
.moldura figcaption em{font:italic 300 1.25rem/1.3 var(--serifa);color:var(--texto)}
.ligacao{display:inline-flex;align-items:center;gap:.5rem;min-height:48px;color:var(--champanhe);text-decoration:none;letter-spacing:.16em;text-transform:uppercase;font-size:.8rem;border-bottom:1px solid transparent;transition:border-color .4s var(--sai)}
.ligacao:hover{border-bottom-color:var(--ouro)}
.rotas{list-style:none;margin:0;padding:0;align-self:center}
.rotas li{border-top:1px solid var(--fio-fraco)}
.rotas li:last-child{border-bottom:1px solid var(--fio-fraco)}
.rotas a{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;min-height:64px;text-decoration:none;color:var(--texto)}
.rotas a span{font:400 1.4rem/1.2 var(--serifa)}
.rotas a svg{color:var(--ouro)}
.rotas a::after{content:"";width:22px;height:1px;background:var(--ouro);transition:width .5s var(--sai)}
.rotas a:hover::after{width:40px}
.rotas-dica{display:block;font-size:1rem;color:var(--texto-2);margin-bottom:.8rem}

/* faq: verbetes em numeral romano, resposta abre com fio dourado vertical */
.faq{max-width:52rem;margin-inline:auto;display:grid;gap:.75rem}
.faq details{border:1px solid var(--fio-fraco);transition:border-color .6s var(--sai),background-color .6s var(--sai)}
.faq details[open]{border-color:var(--fio);background:rgba(24,18,12,.7)}
.faq summary{list-style:none;cursor:pointer;min-height:56px;padding:1.3rem 1.25rem;display:grid;grid-template-columns:2.6rem 1fr auto;align-items:baseline;gap:1rem;font:400 1.35rem/1.3 var(--serifa)}
.faq summary::-webkit-details-marker{display:none}
.faq .rom{font:italic 300 1.15rem/1 var(--serifa);color:var(--ouro);text-align:right}
.faq summary::after{content:"";align-self:center;width:8px;height:8px;border:1px solid var(--ouro);rotate:45deg;transition:background-color .5s var(--sai),rotate .6s var(--sai)}
.faq details[open] summary::after{background:var(--ouro);rotate:225deg}
.faq details p{color:var(--texto-2);margin:0 1.25rem 1.6rem calc(1.25rem + 3.6rem);padding-left:1.2rem;border-left:1px solid var(--ouro);max-width:40rem}
@media (max-width:480px){.faq summary{grid-template-columns:1.8rem 1fr auto;padding-inline:1rem}.faq details p{margin-left:1rem}}

/* cta final */
.final{text-align:center}
.final .painel{padding:clamp(3rem,2rem + 5vw,6rem) 1.5rem;display:grid;gap:1.5rem;justify-items:center}
.final h2{max-width:40rem}
.final p{max-width:34rem;color:var(--texto-2)}

/* rodapé: colofão centrado com ornamento */
footer{padding:4rem 0 3rem;text-align:center;color:var(--texto-2);font-size:1rem}
.orn{display:flex;align-items:center;justify-content:center;gap:1rem;margin-bottom:2rem;color:var(--ouro)}
.orn::before,.orn::after{content:"";height:1px;width:min(30vw,180px);background:linear-gradient(90deg,transparent,var(--fio))}
.orn::after{rotate:180deg}
footer .nome{display:block;font:300 clamp(1.6rem,1.2rem + 2vw,2.4rem)/1.15 var(--serifa);color:var(--texto);margin-bottom:1rem;text-wrap:balance}
footer .linha{display:flex;flex-wrap:wrap;justify-content:center;gap:0 1.5rem;margin-top:.75rem}
footer a{display:inline-flex;align-items:center;gap:.5rem;min-height:48px;color:var(--champanhe);text-decoration:none}
footer a:hover{text-decoration:underline}

/* contato: um único botão que abre uma folha vinda de baixo */
.barra-fixa{position:static}
.chamar{position:fixed;z-index:6;left:50%;bottom:calc(1rem + env(safe-area-inset-bottom));translate:-50% 0}
.chamar{display:inline-flex;align-items:center;gap:.75rem;min-height:56px;padding:0 1.6rem 0 1.3rem;background:rgba(13,10,7,.92);color:var(--champanhe);border:1px solid var(--ouro);
  font:400 .82rem/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;cursor:pointer;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  box-shadow:0 12px 32px rgba(0,0,0,.55);transition:opacity .5s var(--sai),translate .6s var(--sai),background-color .5s var(--sai)}
.chamar:hover{background:var(--painel)}
.chamar .ponto{width:6px;height:6px;rotate:45deg;background:var(--ouro)}
.aberta .chamar{opacity:0;translate:-50% 1rem;pointer-events:none}
.veu{position:fixed;inset:0;z-index:7;background:rgba(5,4,2,.66);opacity:0;pointer-events:none;transition:opacity .6s var(--sai)}
.aberta .veu{opacity:1;pointer-events:auto}
.folha{position:fixed;z-index:8;left:0;right:0;bottom:0;margin-inline:auto;width:min(100%,32rem);background:var(--fundo-2);border:1px solid var(--fio);border-bottom:0;
  padding:.5rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));translate:0 calc(100% + 2rem + var(--arrasto,0px));visibility:hidden;
  transition:translate .7s var(--sai),visibility 0s .7s;box-shadow:0 -20px 60px rgba(0,0,0,.6)}
.aberta .folha{translate:0 var(--arrasto,0px);visibility:visible;transition:translate .7s var(--sai)}
.folha.arrastando{transition:none}
.alca{display:grid;place-items:center;width:100%;min-height:48px;background:none;border:0;cursor:grab;touch-action:none;color:var(--texto-2)}
.alca::before{content:"";width:44px;height:1px;background:var(--ouro);box-shadow:0 4px 0 var(--fio-fraco)}
.folha h2{font-size:2rem;text-align:center;margin:.25rem 0 .4rem}
.folha .dica{text-align:center;color:var(--texto-2);font-size:1rem;margin-bottom:1.25rem}
.folha ul{list-style:none;margin:0;padding:0}
.folha li+li{border-top:1px solid var(--fio-fraco)}
.folha li a{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:1rem;min-height:72px;text-decoration:none;color:var(--texto)}
.folha .ico{width:34px;height:34px;margin-inline:auto;display:grid;place-items:center;border:1px solid var(--fio);rotate:45deg}
.folha .ico svg{rotate:-45deg;color:var(--champanhe)}
.folha li b{display:block;font:400 1.45rem/1.2 var(--serifa)}
.folha li small{display:block;font-size:1rem;color:var(--texto-2);font-variant-numeric:tabular-nums}
.folha li a::after{content:"";width:18px;height:1px;background:var(--ouro);transition:width .5s var(--sai)}
.folha li a:hover::after{width:32px}
.folha li:nth-child(n){transition:opacity .6s var(--sai),translate .7s var(--sai)}
.folha:not(.vista) li{opacity:0;translate:0 .8rem}
.folha li:nth-child(2){transition-delay:.08s}.folha li:nth-child(3){transition-delay:.16s}
body{--barra:calc(88px + env(safe-area-inset-bottom))}

@media (min-width:700px){
  .servicos{grid-template-columns:repeat(2,minmax(0,1fr))}
  .passos{grid-template-columns:repeat(3,minmax(0,1fr))}
  .contato{grid-template-columns:repeat(2,minmax(0,1fr))}
  .chegar{grid-template-columns:1.5fr 1fr;align-items:center;gap:3rem}
  .mapa{aspect-ratio:4/3}
  .painel{padding:2.6rem 2.2rem}
}
@media (min-width:1100px){
  .chamar{left:auto;right:2rem;bottom:2rem;translate:none}
  .aberta .chamar{translate:0 1rem}
  .servicos{grid-template-columns:repeat(3,minmax(0,1fr))}
  .mapa{aspect-ratio:16/11}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .js .surge:not(.visto){opacity:1;filter:none}
  .risca::after{transform:scaleX(1)}
  .brilho::before{top:-10vmax}
}
</style>
{{ ef.estilo() }}
</head>
<body>
{{ ef.progresso() }}
<div class="brilho" aria-hidden="true"></div>
<header class="topo"><span class="marca rv">{{ c.nome_exibicao }}</span></header>
<main>
  <section class="hero">
    <div class="mx">
      <span class="filete rv" style="--i:1" aria-hidden="true"></span>
      <h1 class="rv">{{ c.headline | replace("-", "‑") }}</h1>
      <p class="sub rv" style="--i:4">{{ c.subtitulo | replace("-", "‑") }}</p>
      <div class="acoes rv" style="--i:5">
        <a class="btn cheio" href="{{ d.wa_link }}"{% if wa %} target="_blank" rel="noopener"{% endif %}>{{ ic_contato_cta }}<span>{{ c.cta }}</span></a>
        <a class="btn" href="{{ d.tel_link }}">{{ ic_tel }}<span>Ligar</span></a>
      </div>
      {% if nota %}<a class="selo rv" style="--i:6" href="{{ d.avaliar }}" target="_blank" rel="noopener" aria-label="Nota {{ nota }} no Google{% if lead.avaliacoes %}, {{ lead.avaliacoes }} avaliações{% endif %}. Avaliar no Google">
        <span class="anel">{{ ic_estrela }}<b>{{ ef.conta(nota) }}</b></span>
        <span class="rot">no Google</span>
        {% if lead.avaliacoes %}<span class="num">{{ ef.conta(lead.avaliacoes) }} avaliações</span>{% endif %}
      </a>{% endif %}
    </div>
  </section>
  {% if "parallax" in efeitos %}<div class="mx" style="padding-block:1rem 3rem">{{ ef.parallax() }}</div>{% endif %}

  <section id="servicos">
    <div class="mx">
      <div class="cab surge"><h2>O que fazemos</h2></div>
      <ul class="servicos">
        {% for s in c.servicos %}<li class="painel risca surge" style="--i:{{ loop.index0 % 3 }}"><h3>{{ s.titulo }}</h3><p>{{ s.descricao }}</p></li>{% endfor %}
      </ul>
    </div>
  </section>

  <section>
    <div class="mx">
      <div class="cab surge"><h2>Por que nos escolher</h2></div>
      <ul class="dif"{{ ef.at("revela") }}>
        {% for x in c.diferenciais %}<li class="surge"><h3>{{ x.titulo }}</h3><p>{{ x.descricao }}</p></li>{% endfor %}
      </ul>
    </div>
  </section>
  {{ ef.marquee("O que dizem no Google") }}

  <section>
    <div class="mx">
      <div class="cab surge"><h2>Como funciona</h2></div>
      <ol class="passos">
        {% for p in c.passos %}<li class="painel surge" style="--i:{{ loop.index0 }}"><span class="n" aria-hidden="true">{{ loop.index }}</span><h3>{{ p.titulo }}</h3><p>{{ p.descricao }}</p></li>{% endfor %}
      </ol>
    </div>
  </section>

  <section id="contato">
    <div class="mx">
      <div class="cab surge"><h2>Fale conosco</h2></div>
      <div class="contato">
        <div class="painel risca surge">
          <h3>Contato</h3>
          {% if lead.endereco %}<p class="endereco">{{ lead.endereco | replace("-", "‑") }}</p>{% endif %}
          <div class="lista-acoes">
            <a class="btn" href="{{ d.tel_link }}">{{ ic_tel }}<span>Ligar <span class="num">{{ lead.telefone }}</span></span></a>
            {% if wa %}<a class="btn" href="{{ d.wa_link }}" target="_blank" rel="noopener">{{ ic_wa }}<span>WhatsApp</span></a>{% endif %}
            {% if vcf %}<a class="btn" href="{{ vcf }}" download="contato.vcf">{{ ic_contato }}<span>Salvar contato</span></a>{% endif %}
            {% if lead.endereco %}<button class="btn" type="button" data-copiar="{{ lead.endereco }}">{{ ic_copiar }}<span data-copiar-rotulo>Copiar endereço</span></button>{% endif %}
            <a class="btn" href="{{ d.avaliar }}" target="_blank" rel="noopener">{{ ic_estrela }}<span>Avaliar no Google</span></a>
          </div>
        </div>
        {% if horario %}
        <div class="painel risca surge" style="--i:1" data-horario='{{ horario | tojson }}'>
          <h3>Horário</h3>
          <p class="agora" data-agora>Confira o horário</p>
          <dl class="horario">
            {% for h in horario %}<div data-dia="{{ loop.index0 }}"><dt>{{ h.dia }}</dt><dd>{{ h.texto }}</dd></div>{% endfor %}
          </dl>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  {% if d.mapa_src %}
  <section id="chegar">
    <div class="mx">
      <div class="cab surge"><h2>Como chegar</h2>{% if lead.bairro %}<p>{{ lead.bairro }}, Santarém</p>{% endif %}</div>
      <div class="chegar">
        <figure class="moldura surge">
          <div class="mapa"><iframe src="{{ d.mapa_src }}" loading="lazy" title="Mapa de {{ c.nome_exibicao }}" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
          <figcaption><em>{{ c.nome_exibicao }}</em><a class="ligacao" href="{{ d.rota_google }}" target="_blank" rel="noopener">{{ ic_pin }}<span>Abrir rota</span></a></figcaption>
        </figure>
        <div class="surge" style="--i:1">
          <small class="rotas-dica">Escolha o aplicativo para traçar a rota:</small>
          <ul class="rotas">
            <li><a href="{{ d.rota_google }}" target="_blank" rel="noopener">{{ ic_pin }}<span>Google Maps</span></a></li>
            <li><a href="{{ d.rota_waze }}" target="_blank" rel="noopener">{{ ic_waze }}<span>Waze</span></a></li>
            <li><a href="{{ d.rota_apple }}" target="_blank" rel="noopener">{{ ic_maca }}<span>Apple Mapas</span></a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {% if c.faq %}
  <section>
    <div class="mx">
      <div class="cab surge"><h2>Perguntas frequentes</h2></div>
      <div class="faq surge">
        {%- set rom = ["I","II","III","IV","V","VI","VII","VIII","IX","X","XI","XII"] -%}
        {% for f in c.faq %}<details><summary><span class="rom" aria-hidden="true">{{ rom[loop.index0] if loop.index0 < 12 else loop.index }}</span><span>{{ f.pergunta }}</span></summary><p>{{ f.resposta }}</p></details>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="final">
    <div class="mx">
      <div class="painel risca surge">
        <h2>{{ c.cta_final_titulo }}</h2>
        <p>{{ c.cta_final_texto }}</p>
        <a class="btn cheio" href="{{ d.wa_link }}"{% if wa %} target="_blank" rel="noopener"{% endif %}>{{ ic_contato_cta }}<span>{{ c.cta }}</span></a>
      </div>
    </div>
  </section>
</main>
<footer>
  <div class="mx">
    <div class="orn" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1"><path d="M7 1l6 6-6 6-6-6z"/><path d="M7 4.5L9.5 7 7 9.5 4.5 7z" fill="currentColor"/></svg></div>
    <span class="nome">{{ c.nome_exibicao }}</span>
    {% if lead.endereco %}<p>{{ lead.endereco | replace("-", "‑") }}</p>{% endif %}
    <div class="linha">
      <a href="{{ d.tel_link }}">{{ ic_tel }}<span class="num">{{ lead.telefone }}</span></a>
      <a href="{{ d.avaliar }}" target="_blank" rel="noopener">{{ ic_estrela }}<span>Avaliar no Google</span></a>
    </div>
  </div>
</footer>
<div class="barra-fixa" data-folha>
  <button class="chamar barra-fixa" type="button" aria-expanded="false" aria-controls="folha"><span class="ponto" aria-hidden="true"></span>Fale conosco</button>
  <div class="veu" data-fechar aria-hidden="true"></div>
  <div class="folha" id="folha" role="dialog" aria-modal="true" aria-labelledby="folha-t">
    <button class="alca" type="button" data-fechar aria-label="Fechar"></button>
    <h2 id="folha-t">Fale conosco</h2>
    <p class="dica">Escolha como prefere falar com a gente.</p>
    <ul>
      <li><a href="{{ d.tel_link }}"><span class="ico">{{ ic_tel }}</span><span><b>Ligar</b><small>{{ lead.telefone }}</small></span></a></li>
      {% if wa %}<li><a href="{{ d.wa_link }}" target="_blank" rel="noopener"><span class="ico">{{ ic_wa }}</span><span><b>WhatsApp</b><small>Resposta por mensagem</small></span></a></li>{% endif %}
      {% if d.mapa_src %}<li><a href="#chegar"><span class="ico">{{ ic_pin }}</span><span><b>Como chegar</b><small>{{ lead.bairro or "Ver no mapa" }}</small></span></a></li>{% endif %}
    </ul>
  </div>
</div>
{{ d.script() }}
<script>
(() => {
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("visto"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px" });
  document.querySelectorAll(".surge").forEach((el) => io.observe(el));
  // folha de contato: abre pelo botão; fecha com Esc, toque no véu, alça ou arrastando a alça para baixo
  const raiz = document.querySelector("[data-folha]"), bt = raiz.querySelector(".chamar"), folha = raiz.querySelector(".folha");
  const fora = [document.querySelector("main"), document.querySelector("footer")];
  const abrir = () => { raiz.classList.add("aberta"); bt.setAttribute("aria-expanded", "true"); fora.forEach((e) => e.inert = true);
    requestAnimationFrame(() => { folha.classList.add("vista"); folha.querySelector("li a")?.focus({ preventScroll: true }); }); };
  const fechar = (volta = true) => { if (!raiz.classList.contains("aberta")) return; raiz.classList.remove("aberta"); folha.classList.remove("vista"); folha.style.removeProperty("--arrasto");
    bt.setAttribute("aria-expanded", "false"); fora.forEach((e) => e.inert = false); if (volta) bt.focus({ preventScroll: true }); };
  bt.addEventListener("click", abrir);
  raiz.querySelectorAll("[data-fechar]").forEach((e) => e.addEventListener("click", () => fechar()));
  folha.querySelectorAll("li a").forEach((a) => a.addEventListener("click", () => fechar(false)));
  addEventListener("keydown", (e) => { if (e.key === "Escape") fechar(); });
  const alca = folha.querySelector(".alca"); let y0 = null, dy = 0;
  alca.addEventListener("pointerdown", (e) => { y0 = e.clientY; dy = 0; folha.classList.add("arrastando"); alca.setPointerCapture(e.pointerId); });
  alca.addEventListener("pointermove", (e) => { if (y0 === null) return; dy = Math.max(0, e.clientY - y0); folha.style.setProperty("--arrasto", dy + "px"); });
  const solta = () => { if (y0 === null) return; y0 = null; folha.classList.remove("arrastando"); if (dy > 70) fechar(); else folha.style.removeProperty("--arrasto"); };
  alca.addEventListener("pointerup", solta); alca.addEventListener("pointercancel", solta);
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  // brilho dourado desce junto com a leitura; rAF passivo, sem tocar no scroll
  const g = document.querySelector(".brilho"); let pend = false;
  const pinta = () => { pend = false; const max = document.documentElement.scrollHeight - innerHeight; g.style.setProperty("--g", max > 0 ? (scrollY / max).toFixed(4) : 0); };
  addEventListener("scroll", () => { if (!pend) { pend = true; requestAnimationFrame(pinta); } }, { passive: true });
  pinta();
})();
</script>
{{ ef.motor() }}
</body>
</html>
