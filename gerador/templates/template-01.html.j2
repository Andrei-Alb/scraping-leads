{% import "_dados.html.j2" as d with context %}{% import "efeitos/_blocos.html.j2" as ef with context %}
{#- Ícones da Revista: traço 1.5, pontas retas, cantos em meia-esquadria, como gravura. -#}
{% macro ic(n) -%}
<svg{% if n == "seta" %} class="seta"{% endif %} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
{%- if n == "tel" %}<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/>
{%- elif n == "wa" %}<path d="M4 20l1.3-4A8.5 8.5 0 1 1 8.5 19z"/><path d="M9 9.5c.5 2.5 2.5 4.5 5 5"/>
{%- elif n == "pin" %}<path d="M12 21s-7-7.2-7-12a7 7 0 0 1 14 0c0 4.8-7 12-7 12z"/><path d="M12 11.5v-5M9.5 9h5"/>
{%- elif n == "bussola" %}<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>
{%- elif n == "mapa" %}<path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14"/>
{%- elif n == "contato" %}<path d="M5 3h14v18H5zM9 3v18"/><path d="M12 8h4M12 12h4"/>
{%- elif n == "estrela" %}<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>
{%- elif n == "copiar" %}<path d="M8 8h12v12H8zM16 8V4H4v12h4"/>
{%- elif n == "seta" %}<path d="M4 12h15M14 7l5 5-5 5"/>
{%- endif %}</svg>
{%- endmacro %}
{#- Revista: editorial impresso. Papel creme, tinta, fios finos que se desenham e títulos que sobem por máscara. -#}
<!doctype html>
<html lang="pt-BR">
<head>
{{ d.head("#f2ebdd") }}
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;1,6..96,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Libre+Franklin:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --papel:#f2ebdd;--tinta:#1c1814;--tinta2:#4a4238;--vinho:#8b1e1e;--verde:#2f6b3a;--fio:#1c1814;--fio-leve:color-mix(in srgb,var(--tinta) 22%,transparent);
  --display:"Bodoni Moda",Didot,"Times New Roman",serif;--texto:"Newsreader",Georgia,serif;--sans:"Libre Franklin",system-ui,sans-serif;
  --m:clamp(1.25rem,5vw,4rem);--ease:cubic-bezier(.16,1,.3,1);
}
*{box-sizing:border-box;margin:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{background:var(--papel);color:var(--tinta);font:400 1.125rem/1.6 var(--texto);padding-bottom:calc(96px + env(safe-area-inset-bottom));overflow-x:clip}
::selection{background:var(--vinho);color:var(--papel)}
a{color:inherit;text-underline-offset:.2em;text-decoration-thickness:1px}
:focus-visible{outline:2px solid var(--vinho);outline-offset:3px}
.num,.sans{font-family:var(--sans);font-variant-numeric:tabular-nums lining-nums;letter-spacing:.02em}
.wrap{max-width:78rem;margin:0 auto;padding-inline:var(--m)}
.fio{height:1px;background:var(--fio);transform-origin:left;border:0}
.fio.duplo{height:4px;background:none;border-top:1px solid var(--fio);border-bottom:1px solid var(--fio)}

/* Masthead */
.cabeca{padding-top:1rem}
.cabeca .linha{display:flex;justify-content:space-between;gap:1rem;font-size:.8125rem;text-transform:uppercase;padding:.6rem 0}
.cabeca .linha span:last-child{text-align:right}
/* Capa */
.capa{padding-block:clamp(2rem,6vw,4.5rem) clamp(2.5rem,7vw,5rem)}
.capa .nome{font:italic 500 clamp(1.25rem,4vw,1.75rem)/1.2 var(--display);color:var(--vinho);margin-bottom:1.25rem;overflow-wrap:break-word}
.capa h1{font:500 clamp(2.4rem,10.5vw,6rem)/.98 var(--display);letter-spacing:-.025em;text-wrap:balance;hyphens:manual;overflow-wrap:normal}
.capa-pe{display:grid;gap:2rem;margin-top:clamp(2rem,5vw,3.5rem)}
.dek{font-size:clamp(1.2rem,2.4vw,1.45rem);line-height:1.5;max-width:36ch;color:var(--tinta2)}
.acoes{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:52px;padding:0 1.5rem;font:600 1rem/1 var(--sans);text-decoration:none;border:1px solid var(--tinta);transition:background .25s var(--ease),color .25s var(--ease)}
.btn.cheio{background:var(--tinta);color:var(--papel)}
.btn.cheio:hover{background:var(--vinho);border-color:var(--vinho)}
.btn:not(.cheio):hover{background:var(--tinta);color:var(--papel)}

/* Seções */
section{padding:clamp(3.5rem,9vw,7rem) 0 0}
.titulo-sec{display:grid;grid-template-columns:auto 1fr;gap:.25rem 1rem;align-items:end;margin-bottom:clamp(1.75rem,4vw,3rem)}
.titulo-sec .n{font:500 .9375rem/1 var(--sans);color:var(--vinho);padding-bottom:.55rem}
.titulo-sec h2{font:500 clamp(2rem,6.5vw,4rem)/1.02 var(--display);letter-spacing:-.02em;text-wrap:balance;overflow-wrap:break-word}
.titulo-sec .fio{grid-column:1/-1;margin-top:.9rem}

/* Artigos (serviços) */
.artigos{display:grid;gap:2.5rem 2.5rem}
.artigo{border-top:1px solid var(--fio);padding-top:1rem;position:relative}
.artigo .n{font:500 .875rem/1 var(--sans);color:var(--vinho)}
.artigo h3{font:500 clamp(1.5rem,3.4vw,1.9rem)/1.12 var(--display);margin:.7rem 0 .6rem;text-wrap:balance}
.artigo p{color:var(--tinta2);max-width:62ch}

/* Diferenciais: citação + colunas */
.citacao{font:italic 500 clamp(1.7rem,5.2vw,3.2rem)/1.15 var(--display);max-width:22ch;text-wrap:balance;margin-bottom:2.5rem}
.citacao::before{content:"“";color:var(--vinho)}
.citacao::after{content:"”";color:var(--vinho)}
.citacao-legenda{font-size:1.0625rem;color:var(--tinta2);max-width:52ch;margin:-1.5rem 0 3rem}
.colunas{display:grid;gap:2rem}
.colunas article{border-top:1px solid var(--fio);padding-top:1rem}
.colunas h3{font:600 1.0625rem/1.3 var(--sans);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.5rem}
.colunas p{color:var(--tinta2)}

/* Passos */
.passos{list-style:none;padding:0;counter-reset:p}
.passos li{display:grid;grid-template-columns:4.5rem 1fr;gap:1rem;padding:1.5rem 0;border-top:1px solid var(--fio);counter-increment:p}
.passos li::before{content:counter(p);font:500 clamp(3rem,8vw,4.5rem)/.85 var(--display);color:var(--vinho)}
.passos h3{font:500 1.5rem/1.2 var(--display);margin-bottom:.35rem}
.passos p{color:var(--tinta2);max-width:58ch}

/* Serviço ao leitor */
.ficha{display:grid;gap:2.5rem}
.ficha h3{font:600 .9375rem/1.2 var(--sans);text-transform:uppercase;letter-spacing:.06em;border-top:1px solid var(--fio);padding-top:.8rem;margin-bottom:1rem}
.endereco{font:500 1.375rem/1.35 var(--display);margin-bottom:1rem;overflow-wrap:anywhere}
.lista-links{display:grid;gap:0;list-style:none;padding:0}
.lista-links li{border-bottom:1px solid var(--fio-leve)}
.lista-links a,.lista-links button{display:flex;align-items:center;gap:.75rem;min-height:56px;width:100%;font:500 1.0625rem/1.2 var(--sans);text-decoration:none;background:none;border:0;color:inherit;cursor:pointer;text-align:left;padding:.5rem 0}
.lista-links a:hover,.lista-links button:hover{color:var(--vinho)}
.lista-links svg{flex:none;width:20px;height:20px}
.lista-links .seta{margin-left:auto;transition:transform .3s var(--ease)}
.lista-links a:hover .seta,.lista-links button:hover .seta{transform:translateX(4px)}
.agora{font:600 1rem/1.3 var(--sans);margin-bottom:.75rem;display:flex;align-items:center;gap:.5rem}
.agora::before{content:"";width:.6rem;height:.6rem;border-radius:50%;background:var(--tinta2)}
.agora[data-aberto="1"]::before{background:var(--verde)}
.agora[data-aberto="0"]::before{background:var(--vinho)}
.horas{width:100%;border-collapse:collapse}
.horas td{padding:.55rem 0;border-bottom:1px solid var(--fio-leve);font-size:1rem}
.horas td:last-child{text-align:right;font-family:var(--sans);font-variant-numeric:tabular-nums}
.horas tr[data-hoje] td{font-weight:600;color:var(--vinho)}

/* Mapa: figura de revista com legenda e créditos de rota */
.mapa{margin:3rem 0 0}
.mapa .moldura{position:relative;border-top:4px double var(--fio);border-bottom:1px solid var(--fio);padding:.75rem 0}
.mapa iframe{display:block;width:100%;height:clamp(260px,50vw,440px);border:0;filter:grayscale(1) sepia(.3) contrast(.92)}
.mapa .abrir{position:absolute;top:1.5rem;right:.75rem;display:inline-flex;align-items:center;gap:.5rem;min-height:48px;padding:0 1rem;background:var(--papel);border:1px solid var(--tinta);font:600 1rem/1 var(--sans);text-decoration:none}
.mapa .abrir:hover{background:var(--tinta);color:var(--papel)}
.mapa figcaption{display:grid;gap:.75rem;padding-top:.9rem}
.mapa .leg{font:italic 400 1.0625rem/1.5 var(--texto);color:var(--tinta2);max-width:60ch}
.mapa .leg b{font:600 .9375rem/1 var(--sans);font-style:normal;color:var(--vinho);margin-right:.4rem}
.creditos{display:flex;flex-wrap:wrap;align-items:center;gap:0 1.25rem;list-style:none;padding:0}
.creditos .rot{font:italic 500 1.0625rem/1 var(--display);color:var(--tinta2)}
.creditos a{display:inline-flex;align-items:center;gap:.45rem;min-height:48px;font:600 1rem/1 var(--sans);text-decoration:underline;text-decoration-color:var(--fio-leve)}
.creditos a:hover{color:var(--vinho);text-decoration-color:currentColor}

/* FAQ: entrevista de revista, P. e R. */
.faq details{border-top:1px solid var(--fio-leve)}
.faq details:first-child{border-top:1px solid var(--fio)}
.faq summary{list-style:none;cursor:pointer;min-height:56px;display:grid;grid-template-columns:3rem 1fr;gap:.75rem;align-items:baseline;padding:1.1rem 0;font:500 clamp(1.2rem,2.6vw,1.5rem)/1.3 var(--display)}
.faq summary::-webkit-details-marker{display:none}
.faq summary .q{font:italic 500 1.25rem/1 var(--display);color:var(--vinho)}
.faq summary .t{text-decoration:underline;text-decoration-color:transparent;text-underline-offset:.18em;transition:text-decoration-color .3s var(--ease)}
.faq summary:hover .t,.faq details[open] .t{text-decoration-color:var(--vinho)}
.faq details>p{position:relative;padding:0 0 1.5rem 3.75rem;color:var(--tinta2);max-width:calc(62ch + 3.75rem)}
.faq details>p::before{content:"R.";position:absolute;left:0;top:0;font:italic 500 1.25rem/1.4 var(--display)}

/* Nota: placar de crítica */
.placar{display:flex;align-items:center;gap:1rem;margin-top:1.5rem;padding:.75rem 0;border-top:4px double var(--fio);border-bottom:1px solid var(--fio);max-width:24rem}
.placar .v{font:600 2.75rem/1 var(--sans);font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.placar .v small{font-size:1rem;color:var(--tinta2);font-weight:500}
.placar p{font:italic 400 1.0625rem/1.35 var(--texto);color:var(--tinta2);border-left:1px solid var(--fio);padding-left:1rem}

/* Fecho */
.fecho{text-align:left;padding-bottom:clamp(3rem,8vw,6rem)}
.fecho h2{font:500 clamp(2.2rem,8vw,5.5rem)/1 var(--display);letter-spacing:-.025em;max-width:16ch;text-wrap:balance;margin:1.5rem 0 1.25rem;overflow-wrap:break-word}
.fecho p{max-width:48ch;color:var(--tinta2);margin-bottom:2rem}

/* Rodapé: expediente */
footer{border-top:4px double var(--fio);padding:2rem 0 2.5rem;background:var(--papel)}
footer .marca{font:italic 500 clamp(1.6rem,6vw,3rem)/1.1 var(--display);margin-bottom:1.5rem;overflow-wrap:break-word;text-wrap:balance}
.expediente{display:grid;gap:1.25rem}
.expediente div{border-top:1px solid var(--fio);padding-top:.6rem}
.expediente dt{font:600 .8125rem/1.2 var(--sans);text-transform:uppercase;letter-spacing:.08em;color:var(--vinho);margin-bottom:.35rem}
.expediente dd{font-size:1rem;color:var(--tinta2);overflow-wrap:anywhere}
.expediente a{display:inline-flex;align-items:center;min-height:48px}

/* Colofão fixo: assinatura + créditos de contato */
.barra-fixa{position:fixed;left:0;right:0;bottom:0;z-index:10;background:var(--papel);border-top:1px solid var(--tinta);box-shadow:0 -8px 24px -12px color-mix(in srgb,var(--tinta) 30%,transparent);padding:.35rem var(--m) env(safe-area-inset-bottom)}
.barra-fixa .ass{font:italic 500 .9375rem/1.3 var(--display);color:var(--vinho);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.barra-fixa ul{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;list-style:none;padding:0}
.barra-fixa li+li{border-left:1px solid var(--fio-leve)}
.barra-fixa a{display:flex;align-items:center;justify-content:center;gap:.35rem;min-height:48px;font:600 .875rem/1 var(--sans);text-decoration:none;white-space:nowrap}
.barra-fixa a:hover,.barra-fixa a:active{color:var(--vinho)}
.barra-fixa svg{width:18px;height:18px;flex:none}
@media (max-width:389px){.barra-fixa{padding-inline:.5rem}.barra-fixa .ass{padding-left:.75rem}.barra-fixa a{gap:.25rem;font-size:.8125rem}.barra-fixa svg{width:16px;height:16px}}

@media (min-width:640px){
  .artigos{grid-template-columns:repeat(2,1fr)}
  .colunas{grid-template-columns:repeat(2,1fr)}
  .expediente{grid-template-columns:repeat(3,1fr)}
}
@media (min-width:900px){
  .capa-pe{grid-template-columns:1.3fr 1fr;align-items:end}
  .colunas{grid-template-columns:repeat(3,1fr)}
  .colunas article{padding-right:1.5rem}
  .ficha{grid-template-columns:1fr 1fr 1fr}
  .passos li{grid-template-columns:8rem 1fr}
  .faq-grid{display:grid;grid-template-columns:1fr 2fr;gap:3rem}
  .faq-grid .titulo-sec{align-self:start;position:sticky;top:2rem}
}
@media (min-width:1100px){
  .artigos{grid-template-columns:repeat(3,1fr)}
  body{padding-bottom:64px}
  .barra-fixa .in-wrap{max-width:78rem;margin:0 auto;display:flex;align-items:center;gap:2rem}
  .barra-fixa .ass{flex:1;font-size:1.0625rem}
  .barra-fixa ul{flex:none;grid-auto-columns:auto}
  .barra-fixa a{padding:0 1.25rem}
}
.nh{white-space:nowrap}

/* Movimento: estados iniciais só existem com JS e sem pedido de menos movimento */
@media (prefers-reduced-motion:no-preference){
  .js .fio,.js .artigo,.js .colunas article,.js .passos li,.js .faq details{--d:0ms}
  .js .anima-fio{transform:scaleX(0);transition:transform 1.1s var(--ease) var(--d,0ms)}
  .js .anima-fio.in{transform:none}
  .js .artigo,.js .colunas article,.js .passos li{background:linear-gradient(var(--fio),var(--fio)) top left/0 1px no-repeat;border-top-color:transparent;transition:background-size 1s var(--ease) var(--d)}
  .js .artigo.in,.js .colunas article.in,.js .passos li.in{background-size:100% 1px}
  .js .mascara{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-bottom:-.08em}
  .js .mascara>span{display:inline-block;transform:translateY(105%);transition:transform 1s var(--ease) var(--d,0ms)}
  .js .in .mascara>span,.js .mascara.in>span{transform:none}
  .js .surge{clip-path:inset(0 0 100% 0);transition:clip-path .9s var(--ease) var(--d,0ms)}
  .js .surge.in{clip-path:inset(0 0 0 0)}
}
</style>
{{ ef.estilo() }}
</head>
<body>
{{ ef.progresso() }}
<header class="cabeca wrap">
  <hr class="fio duplo anima-fio" aria-hidden="true">
  <div class="linha sans"><span>{{ lead.categoria }}</span><span>{{ lead.bairro or "Santarém" }}</span></div>
  <hr class="fio anima-fio" aria-hidden="true">
</header>

<main>
<div class="capa wrap">
  <p class="nome surge">{{ c.nome_exibicao }}</p>
  <h1 data-mascara>{{ c.headline }}</h1>
  <div class="capa-pe">
    <p class="dek surge" style="--d:300ms">{{ c.subtitulo }}</p>
    <div>
      <div class="acoes">
        <a class="btn cheio"{{ ef.at("magnetico") }} href="{{ d.wa_link }}"{% if wa %} target="_blank" rel="noopener"{% endif %}>{{ ic("wa" if wa else "tel") }}{{ c.cta }}</a>
        <a class="btn" href="{{ d.tel_link }}">{{ ic("tel") }}Ligar</a>
      </div>
      {% if nota %}<a class="placar" href="{{ d.avaliar }}" target="_blank" rel="noopener" style="text-decoration:none"><span class="v">{{ ef.conta(nota) }}<small> /5</small></span><p>{% if lead.avaliacoes %}<span class="num" style="font-style:normal">{{ ef.conta(lead.avaliacoes) }}</span> avaliações<br>{% endif %}no Google</p></a>{% endif %}
    </div>
  </div>
</div>
<div class="wrap"><hr class="fio anima-fio" aria-hidden="true"></div>
{% if "zoom" in efeitos %}<div class="wrap" style="padding-block:2rem">{{ ef.zoom() }}</div>{% endif %}

<section id="servicos" class="wrap" aria-labelledby="t-serv">
  <div class="titulo-sec"><span class="n" aria-hidden="true">01</span><h2 id="t-serv" data-mascara>Serviços</h2><hr class="fio anima-fio" aria-hidden="true"></div>
  <div class="artigos">
    {% for s in c.servicos %}
    <article class="artigo" style="--d:{{ loop.index0 % 3 * 120 }}ms">
      <span class="n" aria-hidden="true">{{ "%02d" | format(loop.index) }}</span>
      <h3>{{ s.titulo }}</h3>
      <p>{{ s.descricao }}</p>
    </article>
    {% endfor %}
  </div>
</section>

{% if c.diferenciais %}
<section id="diferenciais" class="wrap" aria-labelledby="t-dif">
  <div class="titulo-sec"><span class="n" aria-hidden="true">02</span><h2 id="t-dif" data-mascara>Por que nós</h2><hr class="fio anima-fio" aria-hidden="true"></div>
  {% set p = c.diferenciais[0] %}
  <p class="citacao surge"{{ ef.at("revela") }}>{{ p.titulo }}</p>
  <p class="citacao-legenda"{{ ef.at("revela") }}>{{ p.descricao }}</p>
  {% if c.diferenciais | length > 1 %}
  <div class="colunas">
    {% for x in c.diferenciais[1:] %}
    <article style="--d:{{ loop.index0 % 3 * 120 }}ms"><h3>{{ x.titulo }}</h3><p>{{ x.descricao }}</p></article>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

<section id="passos" class="wrap" aria-labelledby="t-pas">
  <div class="titulo-sec"><span class="n" aria-hidden="true">03</span><h2 id="t-pas" data-mascara>Como funciona</h2><hr class="fio anima-fio" aria-hidden="true"></div>
  <ol class="passos">
    {% for s in c.passos %}
    <li style="--d:{{ loop.index0 * 120 }}ms"><div><h3>{{ s.titulo }}</h3><p>{{ s.descricao }}</p></div></li>
    {% endfor %}
  </ol>
</section>

<section id="contato" class="wrap" aria-labelledby="t-con">
  <div class="titulo-sec"><span class="n" aria-hidden="true">04</span><h2 id="t-con" data-mascara>Onde e quando</h2><hr class="fio anima-fio" aria-hidden="true"></div>
  <div class="ficha">
    <div>
      <h3>Fale com a gente</h3>
      <ul class="lista-links">
        {% if wa %}<li><a href="{{ d.wa_link }}" target="_blank" rel="noopener">{{ ic("wa") }}WhatsApp{{ ic("seta") }}</a></li>{% endif %}
        <li><a href="{{ d.tel_link }}">{{ ic("tel") }}Ligar <span class="num">{{ lead.telefone }}</span>{{ ic("seta") }}</a></li>
        {% if vcf %}<li><a href="{{ vcf }}" download="contato.vcf">{{ ic("contato") }}Salvar contato{{ ic("seta") }}</a></li>{% endif %}
        <li><a href="{{ d.avaliar }}" target="_blank" rel="noopener">{{ ic("estrela") }}Avaliar no Google{{ ic("seta") }}</a></li>
      </ul>
    </div>
    {% if lead.endereco %}
    <div>
      <h3>Endereço</h3>
      <p class="endereco">{{ lead.endereco }}</p>
      <ul class="lista-links">
        <li><button type="button" data-copiar="{{ lead.endereco }}">{{ ic("copiar") }}<span data-copiar-rotulo>Copiar endereço</span></button></li>
        {% if d.mapa_src %}<li><a href="#chegar">{{ ic("pin") }}Ver no mapa{{ ic("seta") }}</a></li>{% endif %}
      </ul>
    </div>
    {% endif %}
    {% if horario %}
    <div data-horario='{{ horario | tojson }}'>
      <h3>Horário</h3>
      <p class="agora" data-agora>Horário de funcionamento</p>
      <table class="horas"><tbody>
        {% for h in horario %}<tr data-dia="{{ loop.index0 }}"><td>{{ h.dia }}</td><td>{{ h.texto }}</td></tr>{% endfor %}
      </tbody></table>
    </div>
    {% endif %}
  </div>

  {% if d.mapa_src %}
  <figure id="chegar" class="mapa">
    <div class="moldura">
      <iframe src="{{ d.mapa_src }}" loading="lazy" title="Mapa com a localização de {{ c.nome_exibicao }}" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <a class="abrir" href="{{ d.rota_google }}" target="_blank" rel="noopener">{{ ic("seta") }}Abrir rota</a>
    </div>
    <figcaption>
      <p class="leg"><b>Como chegar</b>{{ lead.endereco or c.nome_exibicao }}</p>
      <ul class="creditos">
        <li class="rot" aria-hidden="true">Rota por</li>
        <li><a href="{{ d.rota_google }}" target="_blank" rel="noopener">{{ ic("pin") }}Google Maps</a></li>
        <li><a href="{{ d.rota_waze }}" target="_blank" rel="noopener">{{ ic("bussola") }}Waze</a></li>
        <li><a href="{{ d.rota_apple }}" target="_blank" rel="noopener">{{ ic("mapa") }}Apple Mapas</a></li>
      </ul>
    </figcaption>
  </figure>
  {% endif %}
</section>

{% if c.faq %}
<section id="faq" class="wrap faq" aria-labelledby="t-faq">
  <div class="faq-grid">
    <div class="titulo-sec"><span class="n" aria-hidden="true">05</span><h2 id="t-faq" data-mascara>Perguntas frequentes</h2><hr class="fio anima-fio" aria-hidden="true"></div>
    <div>
      {% for f in c.faq %}
      <details><summary><span class="q" aria-hidden="true">P.{{ loop.index }}</span><span class="t">{{ f.pergunta }}</span></summary><p>{{ f.resposta }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="wrap fecho" aria-labelledby="t-fim">
  <hr class="fio duplo anima-fio" aria-hidden="true">
  <h2 id="t-fim" data-mascara>{{ c.cta_final_titulo }}</h2>
  <p>{{ c.cta_final_texto }}</p>
  <div class="acoes">
    <a class="btn cheio" href="{{ d.wa_link }}"{% if wa %} target="_blank" rel="noopener"{% endif %}>{{ ic("wa" if wa else "tel") }}{{ c.cta }}</a>
    <a class="btn" href="{{ d.tel_link }}">{{ ic("tel") }}Ligar</a>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <p class="marca">{{ lead.nome }}</p>
    <dl class="expediente">
      <div><dt>Telefone</dt><dd><a href="{{ d.tel_link }}" class="num">{{ lead.telefone }}</a></dd></div>
      {% if lead.endereco %}<div><dt>Endereço</dt><dd>{{ lead.endereco | replace("-", "‑") | replace(" ‑ ", " – ") }}</dd></div>{% endif %}
      <div><dt>Ramo</dt><dd>{{ lead.categoria }}{% if lead.bairro %} · {{ lead.bairro }}{% endif %}</dd></div>
    </dl>
  </div>
</footer>

<nav class="barra-fixa" aria-label="Contato">
  <div class="in-wrap">
    <p class="ass" aria-hidden="true">— {{ c.nome_exibicao }}</p>
    <ul>
      <li><a href="{{ d.tel_link }}">{{ ic("tel") }}Ligar</a></li>
      {% if wa %}<li><a href="{{ d.wa_link }}" target="_blank" rel="noopener">{{ ic("wa") }}WhatsApp</a></li>{% endif %}
      {% if d.mapa_src %}<li><a href="#chegar">{{ ic("pin") }}Como chegar</a></li>{% endif %}
    </ul>
  </div>
</nav>

{{ d.script() }}
<script>
(() => {
  // Palavra com hífen não se parte no hífen (ex.: "afastar-se").
  const tw = document.createTreeWalker(document.querySelector("main"), NodeFilter.SHOW_TEXT), nos = [];
  while (tw.nextNode()) if (/\S-\S/.test(tw.currentNode.data) && !tw.currentNode.parentElement.closest("script,style")) nos.push(tw.currentNode);
  nos.forEach((n) => {
    const f = document.createDocumentFragment();
    n.data.split(/(\S+-\S+)/).forEach((t, i) => {
      if (i % 2) { const s = document.createElement("span"); s.className = "nh"; s.textContent = t; f.append(s); } else if (t) f.append(t);
    });
    n.replaceWith(f);
  });
  if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
  // Títulos: cada palavra vira uma máscara; o texto sobe de dentro dela.
  document.querySelectorAll("[data-mascara]").forEach((el) => {
    const palavras = el.textContent.trim().split(/\s+/);
    el.setAttribute("aria-label", el.textContent.trim());
    el.innerHTML = palavras.map((w, i) => `<span class="mascara" aria-hidden="true" style="--d:${i * 70}ms"><span>${w.replace(/[&<>]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[ch])}</span></span>`).join(" ");
  });
  document.documentElement.classList.add("js");
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
  }), { rootMargin: "0px 0px -8% 0px" });
  document.querySelectorAll(".anima-fio,[data-mascara],.surge,.artigo,.colunas article,.passos li").forEach((el) => io.observe(el));
})();
</script>
{{ ef.motor() }}
</body>
</html>
