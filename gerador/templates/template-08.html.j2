{% import "_dados.html.j2" as d with context %}{% import "efeitos/_blocos.html.j2" as ef with context %}<!doctype html>
<html lang="pt-BR">
<head>
{{ d.head("#1d1c1a") }}
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --laranja:#ff5b14; --laranja-esc:#c43d00; --grafite:#1d1c1a; --grafite-2:#2c2a27; --osso:#f4f4f1; --osso-2:#e4e3dd;
  --tinta:#1d1c1a; --suave:#55514b;
  --disp:"Bricolage Grotesque",system-ui,sans-serif; --txt:"Hanken Grotesk",system-ui,sans-serif;
  --borda:2px solid var(--grafite); --raio:18px; --gut:clamp(1rem,4vw,3rem);
  --barra:calc(72px + env(safe-area-inset-bottom));
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--osso);color:var(--tinta);font:400 1.0625rem/1.6 var(--txt);overflow-x:clip}
h1,h2,h3{font-family:var(--disp);font-stretch:85%;line-height:1.1;margin:0;letter-spacing:-.02em;overflow-wrap:normal;word-break:normal;hyphens:none}
p,li,dd,td,summary,blockquote{font-size:1rem}
p{margin:0}
a{color:inherit}
.num{font-variant-numeric:tabular-nums}
.wrap{padding-inline:var(--gut);max-width:1360px;margin-inline:auto}
.selo{display:inline-flex;align-items:center;gap:.5em;font:600 .9375rem/1.3 var(--txt);letter-spacing:.01em}
.selo::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--laranja)}
:focus-visible{outline:3px solid var(--laranja);outline-offset:3px}

/* botões */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;min-height:52px;padding:.85em 1.4em;border-radius:999px;font:600 1rem/1.1 var(--txt);text-decoration:none;border:var(--borda);transition:transform .2s cubic-bezier(.2,.8,.2,1),background-color .2s}
.btn:active{transform:scale(.97)}
.btn-laranja{background:var(--laranja);color:var(--grafite)}
.btn-escuro{background:var(--grafite);color:var(--osso)}
.btn-claro{background:transparent;color:inherit}
@media (hover:hover){.btn-laranja:hover{background:#ff7a3d}.btn-escuro:hover{background:var(--grafite-2)}.btn-claro:hover{background:rgba(29,28,26,.06)}}

/* topo */
.topo{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1rem}
.marca{display:inline-flex;align-items:center;min-height:48px;font:800 1.125rem/1.1 var(--disp);font-stretch:80%;text-decoration:none;max-width:70%}
.topo .btn{display:none}

/* hero */
.hero{overflow-x:clip;padding-block:clamp(1.5rem,6vw,4.5rem) 0}
.hero h1{font-size:clamp(2.4rem,9.4vw,6.6rem);font-weight:800;max-width:14ch;text-wrap:balance}
.hero h1 em{font-style:normal;color:var(--laranja-esc)}
.hero .sub{margin-top:1.25rem;max-width:46ch;color:var(--suave);font-size:1.125rem}
.hero .acoes{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.75rem}
.hero .fatos{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1.5rem;color:var(--suave);font-size:1rem}
.hero .fatos b{color:var(--tinta);font-weight:600}
.letreiro{margin-top:clamp(2.5rem,7vw,5rem);background:var(--laranja);color:var(--grafite);border-block:var(--borda);overflow:hidden;transform:rotate(-2deg);margin-inline:-2rem;padding-block:.5rem}
.letreiro div{display:flex;width:max-content;animation:corre 40s linear infinite}
@media (hover:hover){.letreiro:hover div{animation-play-state:paused}}
.letreiro span{font:800 clamp(1.75rem,6vw,3.5rem)/1.1 var(--disp);font-stretch:75%;text-transform:uppercase;white-space:nowrap;padding-right:.6em}
.letreiro span::after{content:"✺";padding-left:.6em}
@keyframes corre{to{transform:translateX(-50%)}}

/* seções */
section{padding-block:clamp(3.5rem,9vw,7rem)}
.cab{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem 2rem;margin-bottom:1.75rem}
.cab h2{font-size:clamp(2rem,7vw,4.25rem);font-weight:800;max-width:16ch;text-wrap:balance}
.cab p{color:var(--suave);max-width:40ch;margin-top:.75rem}

/* trilho */
.controle{display:flex;align-items:center;gap:1rem}
.dica{display:inline-flex;align-items:center;gap:.5em;font:600 .9375rem/1 var(--txt)}
.dica svg{animation:empurra 1.6s ease-in-out infinite}
@keyframes empurra{50%{transform:translateX(6px)}}
.cont{font:700 1.0625rem/1 var(--txt);font-variant-numeric:tabular-nums;padding:.5em .8em;border:var(--borda);border-radius:999px;min-width:4.5em;text-align:center}
.setas{display:none;gap:.25rem}
.seta{width:52px;height:52px;display:grid;place-items:center;background:none;border:0;padding:0;color:inherit;cursor:pointer;transition:opacity .2s,transform .2s}
.seta svg{width:28px;height:28px}
.seta:disabled{opacity:.3;cursor:default}
@media (hover:hover){.seta:not(:disabled):hover{transform:translateX(var(--d,0))}}
.seta[data-dir="-1"]{--d:-3px}.seta[data-dir="1"]{--d:3px}
.trilho{display:flex;gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;scroll-padding-inline:var(--gut);padding:0 var(--gut) 1.5rem;margin:0;list-style:none;scrollbar-width:thin;scrollbar-color:var(--laranja) transparent}
.trilho:focus-visible{outline-offset:-3px}
.cartaz{flex:0 0 min(80vw,340px);min-height:440px;scroll-snap-align:start;border:var(--borda);border-radius:var(--raio);padding:1.5rem;display:flex;flex-direction:column;background:var(--osso);position:relative;overflow:hidden}
.cartaz .grande{font:800 clamp(7rem,30vw,10rem)/.8 var(--disp);font-stretch:75%;font-variant-numeric:tabular-nums;letter-spacing:-.05em;color:var(--laranja);margin:-.05em 0 auto -.04em;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.cartaz h3{font-size:clamp(1.25rem,6vw,1.75rem);font-weight:700;margin-top:2rem;text-wrap:balance}
.cartaz p{margin-top:.75rem;color:var(--suave)}
.cartaz:nth-child(3n+2){background:var(--grafite);color:var(--osso);border-color:var(--grafite)}
.cartaz:nth-child(3n+2) p{color:#cfc8bb}
.cartaz:nth-child(3n+3){background:var(--laranja)}
.cartaz:nth-child(3n+3) .grande{color:var(--grafite)}
.cartaz:nth-child(3n+3) p{color:var(--grafite)}
@media (hover:hover){.cartaz:hover .grande{transform:translateY(-6px) rotate(-3deg)}}
.cabe .controle{display:none}
.trilho .fim{flex:0 0 1px}

/* passos: cartazes escuros */
.escura{background:var(--grafite);color:var(--osso)}
.escura .cab p{color:#cfc8bb}
.escura .cont{border-color:var(--osso)}
.escura .cartaz{background:var(--grafite-2);border-color:#4a4741}
.escura .cartaz p{color:#cfc8bb}
.escura .cartaz:nth-child(even){background:var(--osso);color:var(--tinta);border-color:var(--osso)}
.escura .cartaz:nth-child(even) p{color:var(--suave)}
.escura .cartaz:nth-child(even) .grande{color:var(--laranja-esc)}
.escura .cartaz:nth-child(3n+3) .grande{color:var(--laranja)}
.escura .cartaz .etapa{font:600 .8125rem/1 var(--txt);letter-spacing:.12em;text-transform:uppercase;margin-top:2rem}
.escura .cartaz .etapa + h3{margin-top:.5rem}

/* diferenciais */
.difs{display:grid;gap:0;border-top:var(--borda);margin:0;padding:0;list-style:none}
.difs li{display:grid;grid-template-columns:auto 1fr;gap:.25rem 1.25rem;padding:1.5rem 0;border-bottom:var(--borda)}
.difs .marca-d{grid-row:span 2;width:44px;height:44px;border-radius:50%;background:var(--laranja);display:grid;place-items:center}
.difs .marca-d svg{width:22px;height:22px}
.difs h3{font-size:clamp(1.375rem,4vw,1.875rem);font-weight:700}
.difs p{color:var(--suave)}

/* contato */
.contato{display:grid;gap:1.5rem}
.painel{border:var(--borda);border-radius:var(--raio);padding:1.5rem;background:#fff}
.painel h3{font-size:1.5rem;font-weight:700;margin-bottom:1rem}
.painel address{font-style:normal;font-size:1.0625rem}
.agora{display:inline-flex;align-items:center;gap:.5em;font-weight:600;margin-bottom:1rem}
.agora::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--suave)}
.agora[data-aberto="1"]::before{background:#1f8a4c}
.agora[data-aberto="0"]::before{background:var(--laranja-esc)}
.horas{margin:0;padding:0;list-style:none}
.horas li{display:flex;justify-content:space-between;gap:1rem;padding:.5rem 0;border-bottom:1px solid var(--osso-2);font-variant-numeric:tabular-nums}
.horas li[data-hoje]{font-weight:700}
.horas li[data-hoje] span:first-child::after{content:" · hoje";color:var(--laranja-esc)}
.acoes-lista{display:grid;gap:.6rem;margin-top:1.25rem}
.acoes-lista .btn{justify-content:flex-start;width:100%}
/* nota: adesivo de preço colado na vitrine */
.nota{display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;padding-bottom:1.25rem;border-bottom:2px dashed var(--osso-2)}
.adesivo{flex:none;width:96px;height:96px;border-radius:50%;background:var(--laranja);border:var(--borda);display:grid;place-content:center;text-align:center;rotate:-10deg;box-shadow:inset 0 0 0 5px var(--laranja),inset 0 0 0 7px var(--grafite)}
.adesivo b{font:800 2.25rem/.9 var(--disp);font-stretch:75%}
.adesivo small{font:700 .75rem/1 var(--txt);letter-spacing:.06em}
.nota p{color:var(--suave)}
.nota p b{color:var(--tinta)}
/* mapa: vitrine com legenda e rotas como canhotos de bilhete */
.vitrine-mapa{margin:0;display:grid;background:var(--grafite);color:var(--osso);border-radius:var(--raio);padding:.625rem;gap:.625rem}
.vitrine-mapa figcaption{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1rem;padding:.375rem .375rem 0;font-weight:600}
.legenda{background:var(--laranja);color:var(--grafite);font:800 1.125rem/1 var(--disp);font-stretch:80%;text-transform:uppercase;padding:.45em .7em;border-radius:6px;rotate:-2deg}
.mapa{border-radius:10px;overflow:hidden;min-height:300px;background:var(--grafite-2)}
.mapa iframe{display:block;width:100%;height:100%;min-height:300px;border:0}
.rotas{list-style:none;margin:0;padding:0;background:var(--osso);color:var(--tinta);border-radius:10px}
.rotas li+li{border-top:2px dashed #b9b6ad}
.rotas a{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;min-height:68px;padding:.75rem 1rem;text-decoration:none;font:700 1.0625rem/1.2 var(--txt)}
.rotas small{display:block;font-weight:400;color:var(--suave);font-size:.9375rem;margin-top:.15rem}
.r-ic{width:40px;height:40px;border-radius:50%;background:var(--grafite);color:var(--laranja);display:grid;place-items:center}
.rotas a>.ic{transition:transform .2s}
@media (hover:hover){.rotas a:hover>.ic{transform:translateX(4px)}}

/* faq: fichas numeradas como etiquetas de prateleira */
.faq{display:grid;gap:.75rem}
.faq details{border:var(--borda);border-radius:12px;background:#fff;overflow:hidden}
.faq summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:auto 1fr;gap:.25rem 1rem;align-items:start;min-height:64px;padding:1rem 1.25rem}
.faq summary::-webkit-details-marker{display:none}
.faq-n{grid-row:span 2;font:800 2.25rem/.9 var(--disp);font-stretch:75%;color:var(--laranja-esc)}
.faq-q{font:700 clamp(1.125rem,3vw,1.3125rem)/1.25 var(--disp)}
.faq-ver{font:600 .9375rem/1.4 var(--txt);color:var(--suave);text-decoration:underline;text-underline-offset:3px}
.faq .v2,.faq details[open] .v1{display:none}
.faq details[open] .v2{display:inline}
.faq details[open] summary{background:var(--grafite);color:var(--osso)}
.faq details[open] .faq-n{color:var(--laranja)}
.faq details[open] .faq-ver{color:#cfc8bb}
.faq p{padding:1rem 1.25rem 1.25rem;color:var(--suave);max-width:65ch}

/* cta final */
.final{background:var(--laranja);border-top:var(--borda)}
.final h2{font-size:clamp(2.2rem,8.5vw,6rem);font-weight:800;max-width:16ch;text-wrap:balance}
.final p{margin-top:1rem;max-width:46ch;font-size:1.125rem}
.final .acoes{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}

/* rodapé: placa da loja */
footer{background:var(--grafite);color:#cfc8bb;padding:3rem 0 calc(170px + env(safe-area-inset-bottom))}
.placa{font:800 clamp(1.75rem,7vw,4.5rem)/.95 var(--disp);font-stretch:75%;color:var(--osso);text-transform:uppercase;letter-spacing:-.01em;text-wrap:balance;padding-bottom:1.5rem;border-bottom:2px solid var(--laranja)}
.rod{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem 2rem;padding-top:1.5rem}
.rod ul{display:flex;flex-wrap:wrap;gap:.25rem 1.5rem;list-style:none;margin:0;padding:0}
.rod a{min-height:48px;display:inline-flex;align-items:center;gap:.5rem;color:var(--osso);text-decoration:none;font-weight:600}
.rod a .ic{color:var(--laranja)}
.rod a[href="#topo"] .ic{rotate:90deg}
@media (hover:hover){.rod a:hover{text-decoration:underline;text-underline-offset:4px}}

/* etiqueta pendurada de vitrine (contato fixo do celular/tablet) */
.etiqueta{position:fixed;right:max(.75rem,env(safe-area-inset-right));bottom:calc(.75rem + env(safe-area-inset-bottom));z-index:20;display:flex;flex-direction:column;align-items:flex-end;gap:.75rem;pointer-events:none}
.etiqueta>*{pointer-events:auto}
.etq{background:none;border:0;padding:0;cursor:pointer;color:var(--grafite);-webkit-tap-highlight-color:transparent}
.etq-pend{display:block;padding-top:30px;position:relative;transform-origin:50% 0;animation:balanca 3.4s ease-in-out infinite}
.etq-pend::before{content:"";position:absolute;left:50%;top:0;width:2px;height:34px;background:var(--grafite);translate:-50% 0}
.etq-pend::after{content:"";position:absolute;left:50%;top:-4px;width:10px;height:10px;border-radius:50%;background:var(--grafite);translate:-50% 0}
.etq-corpo{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;width:84px;height:104px;padding:0 .5rem .75rem;background:var(--laranja);border:2px solid var(--grafite);border-radius:40px 40px 12px 12px / 26px 26px 12px 12px;box-shadow:0 12px 22px -10px rgba(29,28,26,.6)}
.etq-corpo::before{content:"";position:absolute;top:10px;left:50%;width:12px;height:12px;border-radius:50%;border:2px solid var(--grafite);background:var(--osso);translate:-50% 0}
.etq-corpo b{font:800 1.75rem/1 var(--disp);font-stretch:75%}
.etq-corpo small{font:700 .8125rem/1.1 var(--txt);text-align:center}
.etq-x{display:none}
.etq:focus-visible{outline:none}
.etq:focus-visible .etq-corpo{outline:3px solid var(--grafite);outline-offset:-6px}
@keyframes balanca{0%,100%{rotate:-5deg}50%{rotate:5deg}}
.aberta .etq-pend{animation:none;rotate:0deg}
.aberta .etq-corpo b,.aberta .etq-corpo small{display:none}
.aberta .etq-x{display:grid;place-items:center;margin-bottom:.5rem}
.aberta .etq-corpo{justify-content:center;padding-bottom:0}
.aberta .etq-corpo::after{content:"Fechar";font:700 .8125rem/1 var(--txt)}
.etq-menu{list-style:none;margin:0;padding:0;display:grid;gap:.5rem;justify-items:end;visibility:hidden}
.etq-menu li{opacity:0;translate:0 12px;transition:opacity .2s,translate .25s cubic-bezier(.2,.8,.2,1)}
.etq-menu a{display:flex;align-items:center;gap:.6rem;min-height:52px;min-width:190px;padding:0 1.1rem;background:var(--osso);color:var(--grafite);border:2px solid var(--grafite);border-radius:8px 999px 999px 8px;font:700 1.0625rem/1 var(--txt);text-decoration:none;box-shadow:0 8px 20px -10px rgba(29,28,26,.6)}
.etq-menu a.wa{background:var(--grafite);color:var(--osso)}
.etq-menu li:nth-child(1){rotate:-1.5deg}.etq-menu li:nth-child(2){rotate:1deg}.etq-menu li:nth-child(3){rotate:-.5deg}
.aberta .etq-menu{visibility:visible}
.aberta .etq-menu li{opacity:1;translate:0 0}
.aberta .etq-menu li:nth-child(2){transition-delay:.04s}.aberta .etq-menu li:nth-child(3){transition-delay:.08s}

@media (min-width:768px){
  .cartaz{flex-basis:320px;min-height:500px}
  .contato{grid-template-columns:1fr 1fr}
  .contato .mapa-col{grid-column:1/-1}
  .vitrine-mapa{grid-template-columns:1.6fr 1fr;grid-template-rows:auto 1fr}
  .vitrine-mapa figcaption{grid-column:1/-1}
  .vitrine-mapa .mapa,.vitrine-mapa .mapa iframe{min-height:100%;height:100%}
  .vitrine-mapa .mapa{min-height:360px}
  .faq{grid-template-columns:1fr 1fr;align-items:start}
  .difs{grid-template-columns:1fr 1fr;column-gap:3rem}
}
@media (min-width:1024px){
  .etiqueta{display:none}
  footer{padding-bottom:3rem}
  .topo .btn{display:inline-flex}
  .setas{display:flex}
  .cartaz{flex-basis:340px}
  .contato{grid-template-columns:1fr 1.2fr}
  .hero .grid{display:grid;grid-template-columns:1.6fr 1fr;gap:3rem;align-items:end}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
</style>
{{ ef.estilo() }}
</head>
<body>
{#- Conjunto próprio: grade 24, traço 2, pontas e cantos redondos. -#}
{%- set ICONES = {
  "seta": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "volta": '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  "tel": '<path d="M6.5 3h3l1.5 4.5-2 1.5a11 11 0 0 0 6 6l1.5-2 4.5 1.5v3a2 2 0 0 1-2 2A17 17 0 0 1 4.5 5a2 2 0 0 1 2-2z"/>',
  "wa": '<path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z"/><path d="M9 9c.3 2.6 2.4 4.7 5 5"/>',
  "pin": '<path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
  "pessoa": '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>',
  "copia": '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/>',
  "estrela": '<path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>',
  "waze": '<path d="M4 15a8 8 0 1 1 15.5-2.5c0 3-2 4.5-4.5 4.5H9a3 3 0 0 1-5-2z"/><circle cx="9" cy="19.5" r="1.5"/><circle cx="16" cy="19.5" r="1.5"/>',
  "bussola": '<path d="M3 11l18-8-8 18-2-8z"/>',
  "check": '<path d="M5 12l5 5 9-10"/>',
  "x": '<path d="M6 6l12 12M18 6L6 18"/>'
} %}
{%- macro ic(n, t=20) %}<svg class="ic" viewBox="0 0 24 24" width="{{ t }}" height="{{ t }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ ICONES[n] | safe }}</svg>{% endmacro %}
{%- set svg_seta = ic("seta") %}
{%- set svg_tel = ic("tel") %}
{%- set svg_wa = ic("wa") %}
{%- set svg_pin = ic("pin") %}

{%- macro trilho(id, titulo, texto, itens, rotulo, escuro=false) %}
<section {% if escuro %}class="escura" {% endif %}aria-labelledby="{{ id }}-t">
  <div class="wrap cab">
    <div>
      <span class="selo">{{ rotulo }}</span>
      <h2 id="{{ id }}-t" style="margin-top:.75rem">{{ titulo }}</h2>
      {% if texto %}<p>{{ texto }}</p>{% endif %}
    </div>
    <div class="controle">
      <span class="dica">Arraste {{ svg_seta | safe }}</span>
      <span class="cont" data-cont aria-live="polite"><span data-atual>1</span> / {{ itens | length }}</span>
      <div class="setas">
        <button class="seta" type="button" data-dir="-1" aria-label="Anterior" aria-controls="{{ id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button class="seta" type="button" data-dir="1" aria-label="Próximo" aria-controls="{{ id }}">{{ svg_seta | safe }}</button>
      </div>
    </div>
  </div>
  <ol class="trilho" id="{{ id }}" tabindex="0" aria-label="{{ titulo }} — role para o lado">
    {% for i in itens %}
    <li class="cartaz">
      <span class="grande" aria-hidden="true">{{ "%02d" | format(loop.index) }}</span>
      {% if escuro %}<span class="etapa">Passo {{ loop.index }}</span>{% endif %}
      <h3>{{ i.titulo }}</h3>
      <p>{{ i.descricao }}</p>
    </li>
    {% endfor %}
    <li class="fim" aria-hidden="true"></li>
  </ol>
</section>
{%- endmacro %}

<header class="wrap topo">
  <a class="marca" href="#topo">{{ c.nome_exibicao }}</a>
  <a class="btn btn-escuro" href="{{ d.wa_link }}">{{ svg_wa | safe }}{{ "WhatsApp" if wa else "Ligar" }}</a>
</header>

<main id="topo">
<div class="hero">
  <div class="wrap grid">
    <div>
      <span class="selo">{{ lead.categoria or "Atendimento" }}{% if lead.bairro %} · {{ lead.bairro }}{% endif %} · Santarém</span>
      <h1 style="margin-top:1.25rem">{{ c.headline }}</h1>
    </div>
    <div>
      <p class="sub">{{ c.subtitulo }}</p>
      <div class="acoes">
        <a class="btn btn-laranja"{{ ef.at("magnetico") }} href="{{ d.wa_link }}">{% if wa %}{{ svg_wa | safe }}{% else %}{{ svg_tel | safe }}{% endif %}{{ c.cta }}</a>
        <a class="btn btn-claro" href="{{ d.tel_link }}">{{ svg_tel | safe }}Ligar</a>
      </div>
      <div class="fatos">
        {% if nota %}<span><b class="num">{{ nota }}</b> no Google{% if lead.avaliacoes %} · <span class="num">{{ lead.avaliacoes }}</span> avaliações{% endif %}</span>{% endif %}
      </div>
    </div>
  </div>
  <div class="letreiro" aria-hidden="true"><div>
    {% for _ in range(2) %}{% for s in c.servicos %}<span>{{ s.titulo }}</span>{% endfor %}{% endfor %}
  </div></div>
</div>
{% if "parallax" in efeitos %}<div class="wrap" style="padding-block:2rem">{{ ef.parallax() }}</div>{% endif %}

{% if "horizontal" in efeitos %}{{ ef.horizontal(c.servicos, "O que fazemos", "Serviços", "servicos") }}{% else %}{{ trilho("servicos", "O que fazemos", None, c.servicos, "Serviços") }}{% endif %}
{{ ef.marquee("Quem já veio") }}

<section aria-labelledby="dif-t" style="padding-top:0">
  <div class="wrap">
    <div class="cab"><div><span class="selo">Por que nós</span><h2 id="dif-t" style="margin-top:.75rem">Diferenciais</h2></div></div>
    <ul class="difs">
      {% for x in c.diferenciais %}
      <li><span class="marca-d" aria-hidden="true">{{ ic("check", 22) }}</span><h3>{{ x.titulo }}</h3><p>{{ x.descricao }}</p></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% if "zoom" in efeitos %}<div class="wrap" style="padding-block:1rem 3rem">{{ ef.zoom() }}</div>{% endif %}

{{ trilho("passos", "Como funciona", "Simples assim, do primeiro contato até o atendimento.", c.passos, "Passo a passo", true) }}

<section aria-labelledby="contato-t">
  <div class="wrap">
    <div class="cab"><div><span class="selo">Contato</span><h2 id="contato-t" style="margin-top:.75rem">Fale com a gente</h2></div></div>
    <div class="contato">
      <div class="painel">
        <h3>Atendimento</h3>
        {% if horario %}
        <div data-horario='{{ horario | tojson }}'>
          <p class="agora" data-agora>Confira o horário</p>
          <ul class="horas">{% for h in horario %}<li data-dia="{{ loop.index0 }}"><span>{{ h.dia }}</span><span>{{ h.texto }}</span></li>{% endfor %}</ul>
        </div>
        {% else %}<p>Chame para combinar o melhor horário.</p>{% endif %}
      </div>
      <div class="painel">
        {% if nota %}
        <div class="nota">
          <span class="adesivo" aria-hidden="true"><b class="num">{{ nota }}</b><small>Google</small></span>
          <p><b class="num">{{ nota }}</b> de 5 no Google{% if lead.avaliacoes %}<br><span class="num">{{ lead.avaliacoes }}</span> avaliações{% endif %}</p>
        </div>
        {% endif %}
        {% if lead.endereco %}<address>{{ lead.endereco | replace('-', '‑') }}</address>{% endif %}
        <div class="acoes-lista">
          <a class="btn btn-escuro" href="{{ d.tel_link }}">{{ svg_tel | safe }}Ligar</a>
          {% if wa %}<a class="btn btn-laranja" href="{{ d.wa_link }}">{{ svg_wa | safe }}WhatsApp</a>{% endif %}
          {% if vcf %}<a class="btn btn-claro" href="{{ vcf }}" download="contato.vcf">{{ ic("pessoa") }}Salvar contato</a>{% endif %}
          {% if lead.endereco %}<button class="btn btn-claro" type="button" data-copiar="{{ lead.endereco }}">{{ ic("copia") }}<span data-copiar-rotulo>Copiar endereço</span></button>{% endif %}
          <a class="btn btn-claro" href="{{ d.avaliar }}" target="_blank" rel="noopener">{{ ic("estrela") }}Avaliar no Google</a>
        </div>
      </div>
      {% if d.mapa_src %}
      <div class="mapa-col" id="chegar">
        <figure class="vitrine-mapa">
          <figcaption><span class="legenda">Como chegar</span>{% if lead.bairro %}<span>{{ lead.bairro }} · Santarém</span>{% endif %}</figcaption>
          <div class="mapa"><iframe src="{{ d.mapa_src }}" loading="lazy" title="Mapa de {{ c.nome_exibicao }}" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
          <ol class="rotas">
            <li><a href="{{ d.rota_google }}" target="_blank" rel="noopener"><span class="r-ic">{{ svg_pin | safe }}</span><span>Google Maps<small>abrir rota</small></span>{{ svg_seta | safe }}</a></li>
            <li><a href="{{ d.rota_waze }}" target="_blank" rel="noopener"><span class="r-ic">{{ ic("waze") }}</span><span>Waze<small>navegar até lá</small></span>{{ svg_seta | safe }}</a></li>
            <li><a href="{{ d.rota_apple }}" target="_blank" rel="noopener"><span class="r-ic">{{ ic("bussola") }}</span><span>Apple Mapas<small>no iPhone</small></span>{{ svg_seta | safe }}</a></li>
          </ol>
        </figure>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% if c.faq %}
<section aria-labelledby="faq-t" style="padding-top:0">
  <div class="wrap">
    <div class="cab"><div><span class="selo">Dúvidas</span><h2 id="faq-t" style="margin-top:.75rem">Perguntas frequentes</h2></div></div>
    <div class="faq">
      {% for f in c.faq %}
      <details><summary><span class="faq-n num" aria-hidden="true">{{ "%02d" | format(loop.index) }}</span><span class="faq-q">{{ f.pergunta }}</span><span class="faq-ver"><span class="v1">Ver resposta</span><span class="v2">Fechar</span></span></summary><p>{{ f.resposta }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="final" aria-labelledby="final-t">
  <div class="wrap">
    <h2 id="final-t">{{ c.cta_final_titulo }}</h2>
    <p>{{ c.cta_final_texto }}</p>
    <div class="acoes">
      <a class="btn btn-escuro" href="{{ d.wa_link }}">{% if wa %}{{ svg_wa | safe }}{% else %}{{ svg_tel | safe }}{% endif %}{{ c.cta }}</a>
      <a class="btn btn-claro" href="{{ d.tel_link }}">{{ svg_tel | safe }}Ligar</a>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <p class="placa">{{ c.nome_exibicao }}</p>
    <div class="rod">
      <p>{% if lead.bairro %}{{ lead.bairro }}, {% endif %}Santarém‑PA</p>
      <ul>
        <li><a href="{{ d.tel_link }}">{{ svg_tel | safe }}Ligar</a></li>
        {% if wa %}<li><a href="{{ d.wa_link }}">{{ svg_wa | safe }}WhatsApp</a></li>{% endif %}
        <li><a href="#topo">{{ ic("volta") }}Voltar ao topo</a></li>
      </ul>
    </div>
  </div>
</footer>

<div class="barra-fixa etiqueta" data-etiqueta>
  <ul class="etq-menu" id="etq-menu" aria-label="Fale com a gente">
    <li><a href="{{ d.tel_link }}">{{ svg_tel | safe }}Ligar</a></li>
    {% if wa %}<li><a class="wa" href="{{ d.wa_link }}">{{ svg_wa | safe }}WhatsApp</a></li>{% endif %}
    {% if d.mapa_src %}<li><a href="#chegar">{{ svg_pin | safe }}Como chegar</a></li>{% endif %}
  </ul>
  <button class="etq" type="button" aria-expanded="false" aria-controls="etq-menu">
    <span class="etq-pend"><span class="etq-corpo"><b>Fale</b><small>com a gente</small><span class="etq-x">{{ ic("x", 18) }}</span></span></span>
  </button>
</div>

{{ d.script() }}
<script>
// Hífen entre letras vira U+2011 (não quebra a palavra no fim da linha).
const hif = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT), nos = [];
while (hif.nextNode()) if (!hif.currentNode.parentElement.closest("script,style")) nos.push(hif.currentNode);
nos.forEach((n) => (n.textContent = n.textContent.replace(/(\p{L})-(?=\p{L})/gu, "$1\u2011")));
document.querySelectorAll(".trilho").forEach((t) => {
  const s = t.closest("section"), cards = [...t.querySelectorAll(".cartaz")], atual = s.querySelector("[data-atual]");
  const [ant, prox] = s.querySelectorAll(".seta");
  const passo = () => cards[0].offsetWidth + parseFloat(getComputedStyle(t).columnGap || 16);
  const sync = () => {
    const fim = t.scrollLeft > t.scrollWidth - t.clientWidth - 4;
    const i = fim ? cards.length - 1 : Math.min(cards.length - 1, Math.round(t.scrollLeft / passo()));
    atual.textContent = i + 1;
    s.classList.toggle("cabe", t.scrollWidth <= t.clientWidth + 4);
    ant.disabled = t.scrollLeft < 4;
    prox.disabled = fim;
  };
  t.addEventListener("scroll", sync, { passive: true });
  addEventListener("resize", sync);
  s.querySelectorAll(".seta").forEach((b) => b.addEventListener("click", () => t.scrollBy({ left: passo() * +b.dataset.dir, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" })));
  sync();
});
// Etiqueta pendurada: abre/fecha as 3 ações; Esc, toque fora ou escolher uma ação fecham.
(() => {
  const e = document.querySelector("[data-etiqueta]"), b = e.querySelector(".etq");
  const abre = (v) => { e.classList.toggle("aberta", v); b.setAttribute("aria-expanded", v); };
  b.addEventListener("click", () => abre(b.getAttribute("aria-expanded") !== "true"));
  e.querySelectorAll(".etq-menu a").forEach((a) => a.addEventListener("click", () => abre(false)));
  document.addEventListener("click", (ev) => { if (!e.contains(ev.target)) abre(false); });
  document.addEventListener("keydown", (ev) => { if (ev.key === "Escape" && e.classList.contains("aberta")) { abre(false); b.focus(); } });
})();
</script>
{{ ef.motor() }}
</body>
</html>
